# Real models on your machine. First: `ollama pull qwen2.5:1.5b-instruct && ollama pull llama3.1:8b`
# and `pip install sentence-transformers` (downloads bge-small-en-v1.5 from Hugging Face on first use).
MAPLEMIND__LLM__PROVIDER=ollama                 # composer/rewriter/classifier via langchain_ollama.ChatOllama
MAPLEMIND__LLM__MODEL=qwen2.5:1.5b-instruct
MAPLEMIND__JUDGE__PROVIDER=ollama               # LLM-as-judge from a different model family
MAPLEMIND__JUDGE__MODEL=llama3.1:8b
MAPLEMIND__EMBEDDINGS__PROVIDER=sentence_transformers   # Chroma collection re-indexes automatically
MAPLEMIND__VECTORSTORE__BACKEND=chroma          # default; numpy is the dependency-free fallback
# MAPLEMIND__RETRIEVAL__RERANK=cross_encoder    # ms-marco-MiniLM cross-encoder
# MAPLEMIND__VISION__BACKEND=hf                 # Food-101 ViT
# Fine-tuned model instead of Ollama:
# MAPLEMIND__LLM__PROVIDER=hf
# MAPLEMIND__LLM__HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct   (+ `maplemind chat --adapter`)
