%% static workflow
---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	safety(safety)
	crisis(crisis)
	screening(screening)
	evidence(evidence)
	composer(composer)
	verifier(verifier)
	navigator(navigator)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> safety;
	composer --> verifier;
	crisis --> finalize;
	evidence --> composer;
	navigator --> finalize;
	safety -.-> crisis;
	safety -. &nbsp;next&nbsp; .-> screening;
	screening -.-> evidence;
	screening -.-> finalize;
	verifier --> navigator;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc


